rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} 문서의 role 필드가 'teacher'인지 여부로 교사 판정 (이메일 하드코딩 없음)
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // 학생 여부 판정 (교사가 아니면 기본 학생)
    function isStudent() {
      return request.auth != null && !isTeacher();
    }

    // 사용자 정보(역할) 컬렉션 규칙
    match /users/{userId} {
      allow read: if request.auth != null;
      // 교사만 권한 부여 및 수정 가능
      allow write: if isTeacher();
    }

    // 메모 컬렉션 규칙
    match /memos/{memoId} {
      // 담벼락 읽기는 모두 허용
      allow read: if true;

      // 생성: 로그인된 사용자만 가능 (교사 또는 학생)
      // 5자 이상 50자 이하, 작성자 uid 일치, 서버 타임스탬프
      allow create: if request.auth != null
        && (isTeacher() || isStudent())
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'uid', 'authorName', 'aiComment'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid;

      // 삭제: 교사만 가능
      allow delete: if isTeacher();

      // 수정: 교사만 가능 (AI 코멘트 추가 등)
      allow update: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
